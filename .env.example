# Copy to .env and fill in. All values seed the database on first boot only;
# afterwards edit them in the web UI (or prefix with FORCE_ to override every boot).

# --- Web UI ---
WEB_HOST=0.0.0.0
WEB_PORT=8344
# Optional HTTP basic auth for the dashboard (leave empty to disable):
WEB_USERNAME=
WEB_PASSWORD=

# --- Scraping ---
ITEMS_PER_QUERY=20
# Minutes between checks (minimum 5 — Vinted bans IPs that poll faster):
REFRESH_MINUTES=5
# Exclude listings whose title contains any of these (separated by |||):
BANWORDS=

# --- Telegram ---
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- ntfy (https://ntfy.sh or self-hosted) ---
NTFY_ENABLED=false
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_PRIORITY=default

# --- RSS (served at /feed.xml) ---
RSS_ENABLED=false
RSS_MAX_ITEMS=100

# --- Proxies (optional) ---
PROXY_LIST=
PROXY_LIST_LINK=
CHECK_PROXIES=false

# --- Logging ---
LOG_LEVEL=INFO
